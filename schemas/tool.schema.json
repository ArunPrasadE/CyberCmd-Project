{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "binary": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[A-Za-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "default": "",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "binary",
    "summary",
    "groups"
  ],
  "additionalProperties": false
}
